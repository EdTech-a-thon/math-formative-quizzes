# Copy this file to .env.production on the production machine.
# This example contains no secrets and is safe to keep in a public repository.
NODE_ENV=production
ADDRESS=0.0.0.0
PORT=8000
ORIGIN=https://math-formative-quizzes.edtechathon.com

# PocketBase stays private at 127.0.0.1:8090; only the website talks to it.
POCKETBASE_DATA_DIR=pb_data
POCKETBASE_BACKUP_DIR=pb_backups

# Optional: name of a 32-character environment variable used to encrypt
# PocketBase settings. Put the variable itself only in the production machine's
# private environment, never in this file.
POCKETBASE_ENCRYPTION_ENV=
